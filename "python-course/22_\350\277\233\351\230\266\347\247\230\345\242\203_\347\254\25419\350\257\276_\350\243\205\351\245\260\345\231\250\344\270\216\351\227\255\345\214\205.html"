function forge(){
  var useLog = document.getElementById('ench-log').checked;
  var useTimer = document.getElementById('ench-time').checked;
  var useDouble = document.getElementById('ench-dbl').checked;
  var lines = [];
  if(useLog || useTimer || useDouble){
    lines.push('# 附魔工坊 · 锻造单（' + ((useLog?1:0)+(useTimer?1:0)+(useDouble?1:0)) + ' 重附魔）');
    lines.push('import time');
    lines.push('from functools import wraps');
    lines.push('');
  }
  if(useDouble){
    lines.push('def double(func):                  # 双重附魔：斩完追击一剑');
    lines.push('    @wraps(func)');
    lines.push('    def wrapper(*args, **kwargs):');
    lines.push('        func(*args, **kwargs)');
    lines.push('        print("💥 双重附魔：追击再斩一剑！")');
    lines.push('    return wrapper');
    lines.push('');
  }
  if(useLog){
    lines.push('def logger(func):                  # 日志附魔：出手前后自动播报');
    lines.push('    @wraps(func)');
    lines.push('    def wrapper(*args, **kwargs):');
    lines.push('        print("[日志]", func.__name__, "开始释放")');
    lines.push('        result = func(*args, **kwargs)');
    lines.push('        print("[日志]", func.__name__, "释放完毕")');
    lines.push('        return result');
    lines.push('    return wrapper');
    lines.push('');
  }
  if(useTimer){
    lines.push('def timer(func):                   # 计时附魔：自动掐表');
    lines.push('    @wraps(func)');
    lines.push('    def wrapper(*args, **kwargs):');
    lines.push('        start = time.perf_counter()');
    lines.push('        result = func(*args, **kwargs)');
    lines.push('        cost = time.perf_counter() - start');
    lines.push('        print(f"[计时] {func.__name__} 耗时 {cost:.6f} 秒")');
    lines.push('        return result');
    lines.push('    return wrapper');
    lines.push('');
  }
  var stack = [];
  if(useTimer) stack.push('@timer');
  if(useLog) stack.push('@logger');
  if(useDouble) stack.push('@double');
  if(stack.length > 0){
    for(var i=0;i<stack.length;i++){
      var cmt = '';
      if(stack.length > 1){
        if(i === 0){ cmt = '   # 最外层，最后套上'; }
        if(i === stack.length-1){ cmt = '   # 最贴近武器，最先生效'; }
      }
      lines.push(stack[i] + cmt);
    }
  }
  lines.push('def attack():');
  lines.push('    print("⚔ 铁剑斩击！造成10点伤害")');
  lines.push('');
  lines.push('attack()');

  document.getElementById('forge-code').innerHTML = hlCode(lines.join('\n'));

  var outLines = [];
  if(useLog) outLines.push('[日志] attack 开始释放');
  outLines.push('⚔ 铁剑斩击！造成10点伤害');
  if(useDouble) outLines.push('💥 双重附魔：追击再斩一剑！');
  if(useLog) outLines.push('[日志] attack 释放完毕');
  if(useTimer) outLines.push('[计时] attack 耗时 ' + (0.00008 + Math.random()*0.0003).toFixed(6) + ' 秒');
  document.getElementById('forge-out').textContent = outLines.join('\n');

  var names = [];
  if(useDouble) names.push('💥 双重附魔');
  if(useLog) names.push('🕯 日志附魔');
  if(useTimer) names.push('⏱ 计时附魔');
  var title, note;
  if(names.length === 0){
    title = '🔨 未附魔 · 原样出货';
    note = '提示：勾选至少一种附魔再点锻造，就能看到动态生成的装饰器代码。试试把三种全勾上，看多重附魔如何一层包一层！';
  } else {
    title = '🔨 锻造完成 · ' + names.join(' + ');
    var order = [];
    if(useDouble) order.push('double');
    if(useLog) order.push('logger');
    if(useTimer) order.push('timer');
    note = '装饰器从下往上包装：' + order[0] + ' 最先裹住 attack';
    for(var j=1;j<order.length;j++){
      note += '，' + order[j] + ' 再在外面裹一层';
    }
    note += '。调用 attack() 时从最外层的 ' + order[order.length-1] + ' 进入，一层层穿到原函数——所以输出顺序和 @ 的书写顺序正好相反。';
  }
  document.getElementById('forge-title').textContent = title;
  document.getElementById('forge-note').textContent = note;
  var res = document.getElementById('forge-result');
  res.classList.remove('show'); void res.offsetWidth; res.classList.add('show');
}

