   opts:['wrapper 函数定义的上一行','装饰器函数 def 的上一行','原函数 def 的上一行','import 语句里面'], ans:0,
   exp:'标准姿势：在 wrapper 的 def 上一行写 @wraps(func)，把原函数的元信息复制给 wrapper。'},
  {q:'想让装饰器能装饰「任意参数」的函数，wrapper 的形参应该写？',
   opts:['*args, **kwargs','只能写固定个数的参数','什么都不写','只写 **kwargs 就够了'], ans:0,
   exp:'*args 接住所有位置参数，**kwargs 接住所有关键字参数，再原样转交给原函数——万能口袋。'},
  {q:'装饰器在什么时候完成包装？',
   opts:['函数定义的那一刻（@ 语句运行时）','每次调用函数时都重新包装','程序退出时','第一次调用时'], ans:0,
   exp:'@deco 在 def 出现时立刻执行 deco(attack) 并完成替换，之后每次调用都直接用同一个 wrapper。'},
  {q:'from functools import lru_cache 后，@lru_cache 的作用是？',
   opts:['缓存相同参数的计算结果，避免重复计算','自动把函数变成异步','自动捕获所有异常','自动给函数生成文档'], ans:0,
   exp:'lru_cache 是标准库自带的缓存装饰器：相同参数第二次调用直接查表返回，是重复计算炸弹的克星。'},
  {q:'堆叠多个装饰器 @A @B def f(): ...，谁先包住 f？',
   opts:['A','B（离 def 近的先包装）','同时包','随机顺序'], ans:1,
   exp:'装饰器从下往上、由内向外包装：B 先裹住 f，A 再裹住 B 的结果。调用时先穿 A 再穿 B。'}
];
(function(){
  var box = document.getElementById('quiz');
  var answered = 0, score = 0;
  quizData.forEach(function(q,idx){
    var div = document.createElement('div');
    div.className = 'quiz-q';
    var optsHtml = q.opts.map(function(o,i){
      return '<button class="qq-opt" data-i="'+i+'">'+String.fromCharCode(65+i)+'. '+o+'</button>';
    }).join('');
    div.innerHTML = '<div class="qq"><i>Q'+(idx+1)+'</i>'+q.q+'</div>'+
      '<div class="qq-opts">'+optsHtml+'</div>'+
      '<div class="qq-exp">'+q.exp+'</div>';
    box.appendChild(div);
    div.querySelectorAll('.qq-opt').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.classList.contains('right')||btn.classList.contains('wrong')) return;
        var i = +btn.dataset.i;
        answered++;
        if(i === q.ans){ btn.classList.add('right'); score++; }
        else{
          btn.classList.add('wrong');
          div.querySelectorAll('.qq-opt')[q.ans].classList.add('right');
        }
        div.querySelector('.qq-exp').classList.add('show');
        if(answered === quizData.length) showResult(score);
      });
    });
  });
  function showResult(s){
    var pts = s * 10;
    var el = document.getElementById('quiz-result');
    var msg = pts >= 80
      ? (pts === 100 ? '满分！附魔宗师，下一课已为你解锁 🔓' : '通关成功！第 20 课「递归与算法」已解锁 🔓')
      : '差一点点！把错题对应的记忆卡片再翻三遍，然后点击刷新重新挑战（每次可重新作答）';
    el.innerHTML = '<b>'+pts+' 分</b>'+s+' / '+quizData.length+' 正确<br>'+msg;
    el.classList.add('show');
    el.scrollIntoView({behavior:'smooth', block:'center'});
  }
})();
</script>
</body>
</html>
