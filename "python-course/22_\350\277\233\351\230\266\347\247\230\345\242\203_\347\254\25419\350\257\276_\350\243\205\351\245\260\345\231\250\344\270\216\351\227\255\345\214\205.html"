/* ============ 通用语法高亮 ============ */
function esc(t){
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function hlCode(src){
  return src.split('\n').map(function(l){
    l = esc(l);
    l = l.replace(/(#.*)$/, "<span class='c'>$1</span>");
    l = l.replace(/("[^"]*")/g, "<span class='s'>$1</span>");
    l = l.replace(/(^|\s)(\d+)(?=\s|$)/g, "$1<span class='n'>$2</span>");
    l = l.replace(/\b(print|input|nonlocal|global|return|import|range|float|while|elif|else|True|False|None|pass|type|str|int|len|def|from|for|and|not|if|in)\b/g, "<span class='k'>$1</span>");
    return l;
  }).join('\n');
}
