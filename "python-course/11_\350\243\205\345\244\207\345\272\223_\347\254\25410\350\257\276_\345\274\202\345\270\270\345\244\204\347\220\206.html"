/* ============ Quiz ============ */
var quizData = [
  {q:'int("abc") 的结果是？',
   opts:['正常得到 0','抛出 ValueError','抛出 TypeError','输出字符串 "abc"'], ans:1,
   exp:'int() 遇到不能转成整数的字符串，抛 ValueError。这是处理用户输入时最常见的异常。'},
  {q:'print(10 / 0) 的结果是？',
   opts:['输出 0','输出 inf','抛出 ZeroDivisionError','抛出 ValueError'], ans:2,
   exp:'除数为零在数学上无定义，Python 抛出 ZeroDivisionError。'},
  {q:'try 里的代码没出错，except 里的代码会执行吗？',
   opts:['会执行','不会执行，整个被跳过','执行一半','报错'], ans:1,
   exp:'except 只在 try 里真的出错时才执行；没出错就整个跳过（如果有 else 块，则执行 else）。'},
