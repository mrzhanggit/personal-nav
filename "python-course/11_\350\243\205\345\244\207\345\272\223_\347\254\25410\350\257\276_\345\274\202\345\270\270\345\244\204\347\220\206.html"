    code:'try:\n    nums = [1, 2, 3]\n    print(nums[5])\nexcept KeyError:\n    print("键不存在")\nexcept IndexError:\n    print("下标越界了")',
    opts:['键不存在','下标越界了','报错：5','输出 3'],
    ans:1,
    exp:'nums[5] 触发的是 IndexError。多个 except 从上到下依次匹配，KeyError 不匹配就跳过，命中第二个分支。'
  },
  {
    title:'第 5 预言 · 崩不了的循环',
    code:'for s in ["10", "abc", "30"]:\n    try:\n        print(int(s))\n    except ValueError:\n        print("跳过")',
    opts:['10 和 30（abc 直接没了）','10、跳过、30 各占一行','只输出 跳过','直接崩溃，一行都不输出'],
    ans:1,
    exp:'int("10") 正常输出 10；int("abc") 抛 ValueError 被捕获，输出「跳过」；循环继续，输出 30。捕获后程序接着跑，这就是护盾的意义。'
  }
];
(function(){
  var box = document.getElementById('oracle');
  oracleData.forEach(function(q, idx){
    var div = document.createElement('div');
    div.className = 'oracle-q';
    var codeHtml = hl(q.code);
    var optsHtml = q.opts.map(function(o, i){
      return '<button class="opt" data-i="' + i + '">' + esc(o) + '</button>';
    }).join('');
    div.innerHTML = '<div class="qtitle">' + q.title + '</div>' +
      '<div class="code" style="margin:6px 0">' + codeHtml + '</div>' +
      '<div class="oracle-opts">' + optsHtml + '</div>' +
      '<div class="explain">' + esc(q.exp) + '</div>';
    box.appendChild(div);
    div.querySelectorAll('.opt').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.classList.contains('right') || btn.classList.contains('wrong')) return;
        var i = +btn.dataset.i;
        if(i === q.ans){ btn.classList.add('right'); }
        else{
          btn.classList.add('wrong');
          div.querySelectorAll('.opt')[q.ans].classList.add('right');
        }
        div.querySelector('.explain').classList.add('show');
      });
    });
  });
})();

