<script>
/* ============ 迷你 Python 语法高亮（供实验室/预言机动态代码使用） ============ */
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
var KW = /^(with|open|as|for|in|if|elif|else|try|except|finally|raise|while|break|continue|pass|print|input|int|str|float|len|read|readline|readlines|write|writelines|close|split|strip|append|ValueError|ZeroDivisionError|KeyError|IndexError|TypeError|FileNotFoundError|Exception|True|False|None|and|or|not)$/;
function hl(code){
  var out = '', i = 0;
  while(i < code.length){
    var ch = code[i];
    if(ch === '"' || ch === "'"){
      var j = i + 1;
      while(j < code.length && code[j] !== ch){ j++; }
      var end = Math.min(j + 1, code.length);
      out += '<span class="s">' + esc(code.slice(i, end)) + '</span>';
      i = end;
    } else if(ch === '#'){
      var j2 = i;
      while(j2 < code.length && code[j2] !== '\n'){ j2++; }
      out += '<span class="c">' + esc(code.slice(i, j2)) + '</span>';
      i = j2;
    } else if(ch >= '0' && ch <= '9'){
      var j3 = i;
      while(j3 < code.length && code[j3] >= '0' && code[j3] <= '9'){ j3++; }
      out += '<span class="n">' + code.slice(i, j3) + '</span>';
      i = j3;
    } else if(/[A-Za-z_]/.test(ch)){
      var j4 = i;
      while(j4 < code.length && /[A-Za-z0-9_]/.test(code[j4])){ j4++; }
      var w = code.slice(i, j4);
      out += KW.test(w) ? '<span class="k">' + w + '</span>' : '<span class="v">' + w + '</span>';
      i = j4;
    } else {
      out += esc(ch);
      i++;
    }
  }
  return out;
}

/* ============ 实验室：打不死的年龄计算器 ============ */
var NOW = new Date().getFullYear();

/* 模拟 Python 的 int()：只有长得像整数的字符串才能转换，否则抛 ValueError（这里返回 null） */
function pyInt(s){
  if(/^\s*[+-]?\d+\s*$/.test(s)){ return parseInt(s, 10); }
  return null;
}
/* 模拟 Python 的 repr()，用于还原真实报错信息 */
function pyRepr(s){
  return "'" + String(s).replace(/['"\\]/g, '') + "'";
}

function chaos(v){
  document.getElementById('birth-year').value = v;
  runAge();
}

function runAge(){
  var raw = document.getElementById('birth-year').value;
  var dispRaw = raw === '' ? '（空）' : raw.replace(/["'\\]/g, '');
  var n = pyInt(raw);

  /* ---------- 无防护版 ---------- */
  var badCode = 'year = input("出生年份：")   # 你输入了：' + dispRaw + '\n' +
    'age = ' + NOW + ' - int(year)\n' +
    'print("你的年龄：", age)';
  document.getElementById('bad-code').innerHTML = hl(badCode);
  var badRun = document.getElementById('bad-run');
  badRun.classList.remove('crash'); void badRun.offsetWidth;
  if(n === null){
    var tb = '💥 程序崩溃了！\n' +
      'Traceback (most recent call last):\n' +
      '  File "age.py", line 2, in <module>\n' +
      '    age = ' + NOW + ' - int(year)\n' +
      'ValueError: invalid literal for int() with base 10: ' + pyRepr(raw);
    badRun.classList.add('crash');
    badRun.innerHTML = esc(tb);
  } else {
    var age = NOW - n;
    var badOut = '你的年龄： ' + age;
    if(n < 0 || age < 0){
      badOut += '\n<span class="c">…没崩，但结果已经很离谱了（输入 ' + esc(dispRaw) + '）</span>';
    }
    badRun.innerHTML = badOut;
  }

  /* ---------- 防护版 ---------- */
  var safeCode = 'try:\n' +
    '    year = int(input("出生年份："))   # 你输入了：' + dispRaw + '\n' +
    '    if year < 0:\n' +
    '        print("年份不能是负数哦")\n' +
    '    elif year > ' + NOW + ':\n' +
    '        print("穿越者？这一年还没到呢")\n' +
    '    else:\n' +
    '        print("你的年龄：", ' + NOW + ' - year)\n' +
    'except ValueError:\n' +
    '    print("这不是数字！请输入如 2008")';
  document.getElementById('safe-code').innerHTML = hl(safeCode);
  var safeRun = document.getElementById('safe-run');
  safeRun.classList.remove('safe'); void safeRun.offsetWidth; safeRun.classList.add('safe');
  var msg, note;
  if(n === null){
    msg = '这不是数字！请输入如 2008';
    note = '🛡 ValueError 被拦下，程序优雅提示';
  } else if(n < 0){
    msg = '年份不能是负数哦';
    note = '🛡 if 校验拦住了负数（这可不抛异常，靠的是校验）';
  } else if(n > NOW){
    msg = '穿越者？这一年还没到呢';
    note = '🛡 逻辑校验稳稳接住未来年份';
  } else {
    msg = '你的年龄： ' + (NOW - n);
    note = '✅ 输入合法，正常计算';
  }
  safeRun.innerHTML = esc(msg) + '\n<span class="c">' + note + '，程序继续运行 ✅</span>';
}

/* 初始演示一次 */
runAge();

/* ============ 预言机 ============ */
var oracleData = [
