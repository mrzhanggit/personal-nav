<script>
/* ============ 功能验收清单（状态存内存变量，页面刷新重置） ============ */
var checkData = [
  '程序能正常启动——即使 todo.json 还不存在',
  'add 添加任务后，list 能立刻看到新任务',
  '输入空白标题会被拦截，不会混进空任务',
  'done 能给指定任务打 ✔，底部统计同步更新',
  'del 能删除指定任务，删除后编号自动重排',
  '输入不存在的编号或未知命令，程序不崩溃、有友好提示',
  'quit 退出后，打开 todo.json 能看到刚才的任务数据',
  '重新启动程序，上次退出前的任务原封不动地回来了'
];
(function(){
  var box = document.getElementById('checklist');
  checkData.forEach(function(text, idx){
    var item = document.createElement('div');
    item.className = 'check-item';
    item.innerHTML = '<div class="box"></div><span>' + text + '</span>';
    item.addEventListener('click', function(){
      item.classList.toggle('done');
      var boxMark = item.querySelector('.box');
      boxMark.textContent = item.classList.contains('done') ? '✔' : '';
      var done = document.querySelectorAll('.check-item.done').length;
      document.getElementById('check-progress').textContent =
        done === checkData.length
          ? '已验收 ' + done + ' / ' + checkData.length + ' —— 验收通过，魔龙血条已清空！'
          : '已验收 ' + done + ' / ' + checkData.length;
    });
    box.appendChild(item);
  });
})();

/* ============ 自评打分表 ============ */
var dims = [
  ['功能完整度', '添加 / 完成 / 删除 / 列出 / 持久化，一个不缺'],
  ['代码正确性', '边界情况全有防御：空标题、错编号、坏文件'],
  ['结构清晰度', '函数各司其职、命名见名知意、注释到位'],
  ['体验友好度', '提示语看得懂、输出排版整齐'],
  ['独立程度', '先自己动手写，卡住了才看引导']
];
var scorePick = [null, null, null, null, null];
(function(){
  var box = document.getElementById('score-table');
  dims.forEach(function(d, idx){
    var row = document.createElement('div');
    row.className = 'score-row';
    var btns = [0, 5, 10, 15, 20].map(function(v){
      return '<button class="sbtn" data-v="' + v + '">' + v + '</button>';
    }).join('');
    row.innerHTML = '<div class="sname">' + (idx + 1) + '. ' + d[0] +
      '</div><div class="sdesc">' + d[1] + '</div><div class="score-btns">' + btns + '</div>';
    box.appendChild(row);
    row.querySelectorAll('.sbtn').forEach(function(btn){
      btn.addEventListener('click', function(){
        row.querySelectorAll('.sbtn').forEach(function(b){ b.classList.remove('on'); });
        btn.classList.add('on');
        scorePick[idx] = +btn.dataset.v;
        updateTotal();
      });
    });
  });
  function updateTotal(){
    var total = 0, picked = 0;
    for(var i = 0; i < scorePick.length; i++){
      if(scorePick[i] !== null){ total += scorePick[i]; picked++; }
    }
    if(picked < dims.length) return;
    var el = document.getElementById('score-total');
    var verdict = total >= 90 ? '传说级神器！可以进军副本挑战了'
      : total >= 80 ? '史诗级佳作！稳稳毕业'
      : total >= 60 ? '合格线以上，回去打磨一下短板再出发'
      : '别灰心，对照评分维度把项目再迭代一版';
    el.innerHTML = '<b>' + total + ' 分</b>自评完成 —— ' + verdict;
    el.classList.remove('show'); void el.offsetWidth; el.classList.add('show');
  }
})();

/* ============ 记忆卡片 ============ */
var cardData = [
  ['列表怎么加元素 / 删元素？', 'append(x) 加到末尾；pop(i) 删除第 i 个并返回它（第 6 课）'],
  ['enumerate(tasks, start=1) 干嘛的？', '遍历时同时拿到编号和元素，start=1 让编号从 1 开始（第 6 课）'],
  ['字典怎么取值 / 改值？', 'd["key"] 取值，d["key"] = 新值 修改；key 不存在会 KeyError（第 7 课）'],
  ['怎么判断 key 在不在字典里？', '用 in：if "title" in task:（第 7 课）'],
  ['怎么判断输入是不是纯数字？', '"42".isdigit() 是 True，"abc".isdigit() 是 False（第 8 课）'],
  ['f-string 怎么写？', 'f"共 {len(tasks)} 项"——大括号里可以放任意表达式（第 8 课）'],
  ['with open(...) as f 好在哪？', '用完自动关闭文件，不怕忘记 f.close()（第 9 课）'],
  ['读写文件为什么要 encoding="utf-8"？', '保证中文读写不乱码（第 9 课）'],
  ['try / except 是干嘛的？', '把可能出错的代码放 try 里，出错就跳进 except 执行，程序不崩溃（第 10 课）'],
  ['json.dump 和 json.load 的区别？', 'dump 把 Python 对象写进文件；load 把文件内容读回 Python 对象（第 9 课）']
];
(function(){
  var grid = document.getElementById('cards');
  cardData.forEach(function(c){
    var d = document.createElement('div');
    d.className = 'mcard';
    d.innerHTML = '<div class="mcard-inner">' +
      '<div class="mface mfront">' + c[0] + '</div>' +
      '<div class="mface mback">' + c[1] + '</div></div>';
    d.addEventListener('click', function(){ d.classList.toggle('flip'); });
    grid.appendChild(d);
  });
})();

/* ============ 设计决策 Quiz ============ */
var quizData = [
  {q:'任务数据为什么存成 json 文件，而不是自己拼字符串写 txt？',
   opts:['json 文件看起来更酷','json 一行代码就能在「Python 对象与文字」间转换，读写都不用手动解析','txt 文件无法用 open 打开','写 json 不需要关闭文件'], ans:1,
   exp:'若用 txt 存 "学习变量|True"，读回来要自己 split 解析，分隔符里再出现 | 就全崩了。json.load/json.dump 自动完成转换，结构化数据的标准答案。'},
  {q:'为什么要拆成 load_tasks、show_tasks 等多个函数，而不是全写进一个大循环？',
   opts:['函数能让代码自动跑得更快','Python 规定必须有函数','每个函数只管一件事，可单独测试、单独修改，主循环只做调度，结构清晰','不拆函数程序无法运行'], ans:2,
   exp:'这是「高内聚、低耦合」的雏形：修 show_tasks 不影响存档逻辑，测 add_task 不用跑整个程序。函数拆分是可维护性的关键。'},
  {q:'每个任务用什么数据结构存放最合适？',
   opts:['一个很长的字符串，用逗号分隔','list 套 dict：list 保持顺序方便按编号操作，dict 描述任务的字段（title / done）','全部用数字编号','一个巨大的 dict，key 是任务名'], ans:1,
   exp:'list 天然有序、可 pop 按下标删除；dict 用字段名取值清晰防错。list 套 dict 是描述「一堆记录」的经典结构。'},
  {q:'什么时候读 todo.json、什么时候写 todo.json？',
   opts:['每敲一个命令就读写一次文件','启动时读一次，退出时写一次','永远不写，数据放内存就行','随机时机读写'], ans:1,
   exp:'启动读、退出写，既保证数据不丢（R5 需求），又不会每次操作都慢吞吞地碰硬盘。若担心中途断电丢数据，进阶做法是每次修改后立即保存。'},
  {q:'load_tasks 里为什么要写 try / except？',
   opts:['为了显得代码长','json.load 随时会报语法错误','todo.json 可能不存在或内容损坏，出错时返回空列表，让程序照样能启动（R6 需求）','try 里的代码跑得更快'], ans:2,
   exp:'第一次运行时文件根本不存在；文件还可能被手滑改坏。异常防御保证任何情况下程序都能体面启动——这是第 10 课装备的实战价值。'}
];
window.__bossQuiz = 0;
(function(){
  var box = document.getElementById('quiz');
  var answered = 0, score = 0;
  quizData.forEach(function(q, idx){
    var div = document.createElement('div');
    div.className = 'quiz-q';
    var optsHtml = q.opts.map(function(o, i){
      return '<button class="qq-opt" data-i="' + i + '">' + String.fromCharCode(65 + i) + '. ' + o + '</button>';
    }).join('');
    div.innerHTML = '<div class="qq"><i>Q' + (idx + 1) + '</i>' + q.q + '</div>' +
      '<div class="qq-opts">' + optsHtml + '</div>' +
      '<div class="qq-exp">' + q.exp + '</div>';
    box.appendChild(div);
    div.querySelectorAll('.qq-opt').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.classList.contains('right') || btn.classList.contains('wrong')) return;
        var i = +btn.dataset.i;
        answered++;
        if(i === q.ans){ btn.classList.add('right'); score++; }
        else{
          btn.classList.add('wrong');
          div.querySelectorAll('.qq-opt')[q.ans].classList.add('right');
        }
        div.querySelector('.qq-exp').classList.add('show');
        window.__bossQuiz = score;
        if(answered === quizData.length) showResult(score);
      });
    });
  });
  function showResult(s){
    var pts = s * 20;
    var el = document.getElementById('quiz-result');
    var msg = pts === 100
      ? '五连击全中！设计思维已成型，快去领取通关认证 🏆'
      : pts >= 80
        ? '险过！但领取通关认证需要 5/5 全对，把错题的设计理由再想一想（刷新页面可重答）'
        : '设计直觉还需打磨：把错题对应章节的代码重读一遍，刷新页面重新挑战';
    el.innerHTML = '<b>' + pts + ' 分</b>' + s + ' / ' + quizData.length + ' 正确<br>' + msg;
    el.classList.add('show');
    el.scrollIntoView({behavior:'smooth', block:'center'});
  }
})();

/* ============ 通关认证 ============ */
function claimCert(){
  if(window.__bossQuiz === quizData.length){
    var cert = document.getElementById('cert');
    cert.classList.add('show');
    cert.scrollIntoView({behavior:'smooth', block:'center'});
  }else{
    alert('遗忘魔龙还未倒下：设计决策 Quiz 需要 5/5 全对（当前 ' + (window.__bossQuiz || 0) + '/5），完成后再来领取认证！');
  }
}
</script>
</body>
</html>
