<script>
/* ============ 实验室一：并发对比实验台 ============ */
var labTasks = [
  {dur: 1.5},
  {dur: 2.0},
  {dur: 2.5}
];
var labSpeed = 2.4;        /* 动画加速倍率：6 秒 → 2.5 秒真实播放 */
var labTimer = null;
var labElapsed = 0;

function resetLab(){
  if(labTimer){ clearInterval(labTimer); labTimer = null; }
  labElapsed = 0;
  for(var i = 0; i < 3; i++){
    document.getElementById('bar' + i).style.width = '0%';
    document.getElementById('st' + i).textContent = '等待中';
    document.getElementById('st' + i).style.color = 'var(--muted)';
  }
  document.getElementById('lab-clock').textContent = '0.0';
  document.getElementById('lab-total').innerHTML = '选一种模式开始实验（动画已加速 2.4 倍播放）';
  document.getElementById('btn-serial').disabled = false;
  document.getElementById('btn-thread').disabled = false;
}

function startLab(mode){
  resetLab();
  document.getElementById('btn-serial').disabled = true;
  document.getElementById('btn-thread').disabled = true;
  /* 串行：依次排队；多线程：同时开始 */
  var offsets = (mode === 'serial') ? [0, 1.5, 3.0] : [0, 0, 0];
  var ends = (mode === 'serial') ? [1.5, 3.5, 6.0] : [1.5, 2.0, 2.5];
  var totalSim = 6.0;
  labTimer = setInterval(function(){
    labElapsed += 0.05 * labSpeed;
    var allDone = true;
    for(var i = 0; i < 3; i++){
      var p;
      if(labElapsed <= offsets[i]) p = 0;
      else if(labElapsed >= ends[i]) p = 1;
      else p = (labElapsed - offsets[i]) / labTasks[i].dur;
      document.getElementById('bar' + i).style.width = (p * 100).toFixed(1) + '%';
      var st = document.getElementById('st' + i);
      if(p >= 1){ st.textContent = '✓ 完成'; st.style.color = 'var(--cyan)'; }
      else if(p > 0){ st.textContent = '下载中… ' + Math.round(p * 100) + '%'; st.style.color = 'var(--pink)'; allDone = false; }
      else{ st.textContent = '等待中'; st.style.color = 'var(--muted)'; allDone = false; }
    }
    document.getElementById('lab-clock').textContent = labElapsed.toFixed(1);
    if(labElapsed >= totalSim || allDone){
      clearInterval(labTimer); labTimer = null;
      var finalT = (mode === 'serial') ? totalSim : 2.5;
      document.getElementById('lab-clock').textContent = finalT.toFixed(1);
      var msg;
      if(mode === 'serial'){
        msg = '总耗时 <b style="color:var(--gold)">6.0 秒</b> —— 1.5 + 2.0 + 2.5 依次排队，时间全部相加。';
