      }
      document.getElementById('lab-total').innerHTML = msg;
      document.getElementById('btn-serial').disabled = false;
      document.getElementById('btn-thread').disabled = false;
    }
  }, 50);
}

/* ============ 实验室二：竞态条件演示器 ============ */
function runRace(useLock){
  var count = 0;
  var threads = [
    {name: '线程A', reg: 0, pc: 0, left: 1000},
    {name: '线程B', reg: 0, pc: 0, left: 1000}
  ];
  var lockHolder = -1;
  var events = [];
  var guard = 0;
  while(guard < 2000000){
    guard++;
    /* 检查是否全部干完 */
    var allDone = true;
    for(var k = 0; k < 2; k++){
      if(threads[k].left > 0 || threads[k].pc > 0){ allDone = false; break; }
    }
    if(allDone) break;
    /* 调度器：锁被占用时只能运行持锁线程；否则随机挑一个（模拟 GIL 随时切换，每次点击都不同） */
    var i;
    if(useLock && lockHolder !== -1){
      i = lockHolder;
    }else{
      i = (Math.random() < 0.5) ? 0 : 1;
    }
    var t = threads[i];
    if(t.left <= 0 && t.pc === 0) continue;
    if(useLock && lockHolder !== -1 && lockHolder !== i) continue;
    if(t.pc === 0){
      if(useLock) lockHolder = i;     /* 进入敏感区：拿锁 */
      t.reg = count;                  /* ① 读 */
      t.pc = 1;
    }else if(t.pc === 1){
      t.reg = t.reg + 1;              /* ② 算 */
      t.pc = 2;
    }else{
      var before = count;
      count = t.reg;                  /* ③ 写回 */
      t.pc = 0;
      t.left--;
      if(useLock) lockHolder = -1;    /* 离开敏感区：还锁 */
      if(!useLock && t.reg <= before && events.length < 3 && before > 0){
        events.push(t.name + ' 把 count 写回 ' + t.reg + '，可另一个线程已把它推到 ' + before + ' —— 覆盖！');
      }
    }
  }
  var el = document.getElementById('race-result');
  var l1 = document.getElementById('race-line1');
  var l2 = document.getElementById('race-line2');
  var lg = document.getElementById('race-log');
  if(!useLock){
    var lost = 2000 - count;
    l1.innerHTML = '🔓 无锁：期望 2000，实际 <b style="color:var(--red)">' + count + '</b>';
    l2.innerHTML = '丢失了 <b style="color:var(--red)">' + lost + '</b> 次更新 —— 再点一次，数字还不一样！';
    lg.innerHTML = '现场抓到的覆盖瞬间（最多 3 条）：<br>' + (events.length ? events.join('<br>') : '这轮运气好没抓到（多试几次）');
  }else{
    l1.innerHTML = '🔒 加锁：期望 2000，实际 <b style="color:var(--gold)">2000</b>';
    l2.innerHTML = '一次三步"读→算→写"原子完成，<b style="color:var(--gold)">每次点都是 2000，稳如老狗</b> ✓';
    lg.innerHTML = 'with lock: 保证了同一时刻只有一个线程能碰 count，另一个只能排队等钥匙。';
  }
  el.classList.remove('show'); void el.offsetWidth; el.classList.add('show');
}

