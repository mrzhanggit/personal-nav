<span class="k">elif</span> <span class="v">choice</span> == <span class="s">"2"</span>:
    <span class="k">print</span>(<span class="s">"你走进废弃矿洞，深处透出一丝微光……"</span>)
    <span class="v">action</span> = <span class="k">input</span>(<span class="s">"1.打开微光处的宝箱 / 2.绕开继续走："</span>)
    <span class="k">if</span> <span class="v">action</span> == <span class="s">"1"</span>:
        <span class="k">print</span>(<span class="s">"宝箱里有 50 金币！但触发了陷阱，HP -35。"</span>)
        <span class="v">gold</span> = <span class="v">gold</span> + <span class="n">50</span>
        <span class="v">hp</span> = <span class="v">hp</span> - <span class="n">35</span>
    <span class="k">else</span>:
        <span class="k">print</span>(<span class="s">"你谨慎绕行，在矿道边捡到 10 金币。"</span>)
        <span class="v">gold</span> = <span class="v">gold</span> + <span class="n">10</span>
<span class="k">elif</span> <span class="v">choice</span> == <span class="s">"3"</span>:
    <span class="k">print</span>(<span class="s">"你来到许愿喷泉，水面泛着蓝光……"</span>)
    <span class="v">action</span> = <span class="k">input</span>(<span class="s">"1.投币许愿(花 10 金币) / 2.喝一口泉水："</span>)
    <span class="k">if</span> <span class="v">action</span> == <span class="s">"1"</span>:
        <span class="k">if</span> <span class="v">gold</span> &gt;= <span class="n">10</span>:
            <span class="k">print</span>(<span class="s">"泉水涌出宝箱！金币 -10 再 +40。"</span>)
            <span class="v">gold</span> = <span class="v">gold</span> - <span class="n">10</span> + <span class="n">40</span>
        <span class="k">else</span>:
            <span class="k">print</span>(<span class="s">"你连 10 金币都掏不出来，精灵叹着气送你 20 金币。"</span>)
            <span class="v">gold</span> = <span class="v">gold</span> + <span class="n">20</span>
    <span class="k">else</span>:
        <span class="k">print</span>(<span class="s">"泉水冰凉刺骨，HP -10，但力量涌动，金币 +25。"</span>)
