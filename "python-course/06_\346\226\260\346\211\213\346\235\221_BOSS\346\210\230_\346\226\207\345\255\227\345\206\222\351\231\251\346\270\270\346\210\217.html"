<script>
/* ============ 验收清单（内存变量记录勾选状态） ============ */
var checkItems = [
  '输入了玩家名字，并且结算时用到了它（print 里出现 name）',
  '剧情分支 ≥ 5 个（三条通道 × 内部选择 + 兜底分支）',
  'HP 有增有减，且有 hp <= 0 的死亡判定',
  '金币有增有减，结算时打印最终金币',
  '结算文案随成绩变化（失败 / 满载而归 / 平平 至少三种）',
  '打完一局可以选择再来一局，且新的一局数值重置',
  '完整代码在电脑上运行无任何报错',
  '亲测玩过至少两局，并且故意"玩死"过一次验证死亡结局'
];
var checkState = [false,false,false,false,false,false,false,false];
(function(){
  var box = document.getElementById('checklist');
  checkItems.forEach(function(text, i){
    var d = document.createElement('div');
    d.className = 'check-item';
    d.innerHTML = '<span class="ckbox"></span><span class="ck-text">'+text+'</span>';
    d.addEventListener('click', function(){
      checkState[i] = !checkState[i];
      d.classList.toggle('done', checkState[i]);
      updateCheckProgress();
    });
    box.appendChild(d);
  });
})();
function updateCheckProgress(){
  var done = 0;
  for(var i=0;i<checkState.length;i++){ if(checkState[i]) done++; }
  document.getElementById('check-fill').style.width = (done / checkItems.length * 100) + '%';
  document.getElementById('check-msg').textContent = '已验收 ' + done + ' / ' + checkItems.length + ' 项' +
    (done === checkItems.length ? ' —— 全部通过！BOSS 点了点头 👹' : '（继续加油）');
  updateCertLocked();
}
function getCheckedCount(){
  var done = 0;
  for(var i=0;i<checkState.length;i++){ if(checkState[i]) done++; }
  return done;
}

/* ============ 自评打分表 ============ */
function calcScore(){
  var total = 0;
  for(var i=0;i<5;i++){ total += parseInt(document.getElementById('sc-'+i).value, 10); }
  var el = document.getElementById('score-result');
  var msg;
  if(total === 0){ msg = '选择每个维度的分数，看看总评'; }
  else if(total >= 90){ msg = '传奇毕业！这个项目已经超出新手村水平了，直接去挑战进阶三连！'; }
  else if(total >= 80){ msg = '优秀！可以昂首挺胸地领取「初级冒险者」称号了。'; }
  else if(total >= 60){ msg = '合格！找到扣分最多的维度，回去针对性改进——这就是升级路线图。'; }
  else { msg = '还不到 60 分？完全没关系，对照评分要点逐条修补，改一版涨一截。'; }
  el.innerHTML = '<b>' + total + ' 分</b>' + msg;
}

/* ============ 记忆卡片（复习第 1-5 课） ============ */
var cardData = [
  ['第1课 · 赋值符号 = 的含义','把右边算好的结果放进左边的盒子（不是数学等于）'],
  ['第1课 · print 里逗号的作用','多个内容用空格连接输出：print("你好", name) → 你好 阿呆'],
  ['第2课 · input() 返回什么类型','永远是字符串 str！要数字必须 int(input(...))'],
  ['第2课 · "等级：" + 10 会怎样','报错 TypeError！要用 str(10) 先转成文字'],
  ['第3课 · if/elif/else 的执行顺序','从上往下依次判断，命中一个分支后其余全部跳过'],
  ['第3课 · == 和 = 的区别','== 是比较相等（返回 True/False）；= 是赋值'],
  ['第4课 · while 什么时候停','条件变成 False 就停；while True 需要配合 break 或开关变量'],
  ['第4课 · break 是干嘛的','立即跳出当前循环，执行循环后面的代码'],
  ['第5课 · 函数怎么定义和调用','def 函数名(参数): 定义；函数名(数据) 调用；先定义后调用'],
  ['第5课 · 形参和实参的区别','形参是定义时的占位名字（def show_status(name)）；实参是调用时传入的真实值']
];
(function(){
  var grid = document.getElementById('cards');
  cardData.forEach(function(c){
    var d = document.createElement('div');
    d.className = 'mcard';
    d.innerHTML = '<div class="mcard-inner">'+
      '<div class="mface mfront">'+c[0]+'</div>'+
      '<div class="mface mback">'+c[1]+'</div></div>';
    d.addEventListener('click', function(){ d.classList.toggle('flip'); });
    grid.appendChild(d);
  });
})();

/* ============ 设计决策 Quiz ============ */
var quizData = [
  {q:'为什么要用 while playing 把「整局游戏」包起来？',
   opts:['让程序跑得更快','支持玩家反复游玩、由玩家决定何时退出','防止程序报错','让代码行数更多'], ans:1,
   exp:'需求书要求"可循环游玩"。while 循环让一局结束后回到开局状态再来一次；把 playing 改成 False 就能优雅退出。'},
  {q:'HP（生命值）最适合用什么数据类型？',
   opts:['int 整数','float 小数','str 字符串','bool 布尔'], ans:0,
   exp:'伤害都是整数，用 int 最自然，hp <= 0 的死亡判断也最直观。float 不会报错但没有必要；str 和 bool 则完全无法参与减法运算。'},
  {q:'剧情分支（玩家选 1/2/3 走不同路线）最适合用什么结构？',
   opts:['一长串互不相关的 if','if/elif/else 链','for 循环','元组'], ans:1,
   exp:'选项之间互斥——只能走一条路。if/elif/else 从上到下判断，命中即止，天然适合互斥选项；一串单独的 if 会把每条都判断一遍，容易出 bug。'},
  {q:'为什么 hp = 100 和 gold = 0 要写在 while 循环体内，而不是循环外？',
   opts:['写在哪都一样','写在循环内，每局开始都会重置回初始值','Python 语法要求必须这样','为了让游戏更难'], ans:1,
   exp:'写在循环内 = 每局重新赋值，血槽回满、金币清零；写在循环外 = 上一局的残血和金币带进下一局，游戏越玩越难（除非你故意设计成"肉鸽继承"）。'},
  {q:'玩家的选择为什么直接和字符串 "1" 比较，而不先 int() 转成数字？',
   opts:['字符串比较速度更快','input() 返回的是字符串，直接比较可避免玩家输入非数字时程序崩溃','Python 不支持 int(input())','效果完全一样，随便选'], ans:1,
   exp:'如果玩家手滑输入"哈"，int("哈") 会直接抛 ValueError 让游戏崩溃；而字符串比较最多落到 else 兜底分支，游戏稳如老狗。防御性思维的第一次实战！'}
];
var quizCorrect = 0;
(function(){
  var box = document.getElementById('quiz');
  var answered = 0, score = 0;
  quizData.forEach(function(q, idx){
    var div = document.createElement('div');
    div.className = 'quiz-q';
    var optsHtml = q.opts.map(function(o,i){
      return '<button class="qq-opt" data-i="'+i+'">'+String.fromCharCode(65+i)+'. '+o+'</button>';
    }).join('');
    div.innerHTML = '<div class="qq"><i>Q'+(idx+1)+'</i>'+q.q+'</div>'+
      '<div class="qq-opts">'+optsHtml+'</div>'+
      '<div class="qq-exp">'+q.exp+'</div>';
    box.appendChild(div);
    div.querySelectorAll('.qq-opt').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.classList.contains('right')||btn.classList.contains('wrong')) return;
        var i = +btn.dataset.i;
        answered++;
        if(i === q.ans){ btn.classList.add('right'); score++; }
        else{
          btn.classList.add('wrong');
          div.querySelectorAll('.qq-opt')[q.ans].classList.add('right');
        }
        div.querySelector('.qq-exp').classList.add('show');
        if(answered === quizData.length) showResult(score);
      });
    });
  });
  function showResult(s){
    quizCorrect = s;
    var pts = s * 20;
    var el = document.getElementById('quiz-result');
    var msg = s >= 4
      ? '设计思维在线！满足认证条件之一 ✔（可前往下方领取「初级冒险者」认证）'
      : '差一点！把错题的解析读三遍，刷新页面重新挑战，答对 4 题才能解锁认证';
    el.innerHTML = '<b>'+pts+' 分</b>'+s+' / '+quizData.length+' 正确<br>'+msg;
    el.classList.add('show');
    updateCertLocked();
    el.scrollIntoView({behavior:'smooth', block:'center'});
  }
})();

/* ============ 通关认证 ============ */
function updateCertLocked(){
  var el = document.getElementById('cert-locked');
  if(!el) return;
  el.textContent = '尚未满足条件：验收清单 ' + getCheckedCount() + '/8 ｜ Quiz ' + quizCorrect + '/5 正确' +
    ((getCheckedCount() === 8 && quizCorrect >= 4) ? '（已满足！输入名字点击领取）' : '（需要 8/8 且 ≥ 4/5）');
}
function checkCert(){
  if(getCheckedCount() < 8 || quizCorrect < 4){
    alert('条件未达成：需要验收清单 8/8 全勾 + Quiz 答对至少 4 题。当前 ' + getCheckedCount() + '/8 与 ' + quizCorrect + '/5。');
    return;
  }
  var name = document.getElementById('cert-name').value.trim();
  if(!name){ name = '无名冒险者'; }
  document.getElementById('cert-holder').textContent = name;
  document.getElementById('cert-locked').style.display = 'none';
  var card = document.getElementById('cert-card');
  card.classList.remove('show'); void card.offsetWidth; card.classList.add('show');
  card.scrollIntoView({behavior:'smooth', block:'center'});
}
</script>
