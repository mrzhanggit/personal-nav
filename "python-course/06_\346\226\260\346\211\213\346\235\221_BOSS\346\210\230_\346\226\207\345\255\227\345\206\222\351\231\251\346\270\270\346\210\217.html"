<span class="k">elif</span> <span class="v">boss</span> == <span class="s">"2"</span>:
    <span class="k">if</span> <span class="v">gold</span> &gt;= <span class="n">20</span>:
        <span class="k">print</span>(<span class="s">"石像鬼追着金币滚远了，有惊无险。金币 -20。"</span>)
