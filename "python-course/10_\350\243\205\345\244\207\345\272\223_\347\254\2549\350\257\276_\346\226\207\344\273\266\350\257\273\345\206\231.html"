<span class="c"># 正确姿势：读和写都明确指定编码</span>
<span class="k">with</span> <span class="k">open</span>(<span class="s">"存档.txt"</span>, <span class="s">"r"</span>, encoding=<span class="s">"utf-8"</span>) <span class="k">as</span> <span class="v">f</span>:
