<script>
/* ============ 迷你 Python 语法高亮（供实验室/预言机动态代码使用） ============ */
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
var KW = /^(with|open|as|for|in|if|elif|else|try|except|finally|raise|while|break|continue|pass|print|input|int|str|float|len|read|readline|readlines|write|writelines|close|split|strip|append|ValueError|ZeroDivisionError|KeyError|IndexError|TypeError|FileNotFoundError|Exception|True|False|None|and|or|not)$/;
function hl(code){
  var out = '', i = 0;
  while(i < code.length){
    var ch = code[i];
    if(ch === '"' || ch === "'"){
      var j = i + 1;
      while(j < code.length && code[j] !== ch){ j++; }
      var end = Math.min(j + 1, code.length);
      out += '<span class="s">' + esc(code.slice(i, end)) + '</span>';
      i = end;
    } else if(ch === '#'){
      var j2 = i;
      while(j2 < code.length && code[j2] !== '\n'){ j2++; }
      out += '<span class="c">' + esc(code.slice(i, j2)) + '</span>';
      i = j2;
    } else if(ch >= '0' && ch <= '9'){
      var j3 = i;
      while(j3 < code.length && code[j3] >= '0' && code[j3] <= '9'){ j3++; }
      out += '<span class="n">' + code.slice(i, j3) + '</span>';
      i = j3;
    } else if(/[A-Za-z_]/.test(ch)){
      var j4 = i;
      while(j4 < code.length && /[A-Za-z0-9_]/.test(code[j4])){ j4++; }
      var w = code.slice(i, j4);
      out += KW.test(w) ? '<span class="k">' + w + '</span>' : '<span class="v">' + w + '</span>';
      i = j4;
    } else {
      out += esc(ch);
      i++;
    }
  }
  return out;
}

/* ============ 实验室：模拟存档系统（内存变量模拟文件） ============ */
var saveFile = null;   // game_save.txt 的内容，null 表示文件还不存在
var logFile = null;    // battle_log.txt 的内容
var battleNo = 0;
var monsters = ['哥布林', '野狼王', '骷髅兵', '暗影蝙蝠', '独眼巨人'];

function gv(id){ return document.getElementById(id).value.trim(); }
function clean(s){ return String(s).replace(/["'\\:]/g, ''); }

function setStatus(steps){
  var box = document.getElementById('lab-status');
  box.innerHTML = '';
  steps.forEach(function(st){
    setTimeout(function(){
      var d = document.createElement('div');
      d.className = 'step ' + (st.c || '');
      d.textContent = st.t;
      box.appendChild(d);
    }, st.d);
  });
}

function renderFile(id, content, newFrom){
  var el = document.getElementById(id);
  el.innerHTML = '';
  if(content === null){
    el.innerHTML = '<div class="empty-file">（文件还不存在）</div>';
    return;
  }
  var lines = content.split('\n');
  if(lines.length && lines[lines.length - 1] === ''){ lines.pop(); }
  lines.forEach(function(l, idx){
    var d = document.createElement('div');
    var isNew = (newFrom !== undefined && idx >= newFrom);
    d.className = 'fline' + (isNew ? ' new' : '');
    if(isNew){ d.style.animationDelay = ((idx - newFrom) * 0.3) + 's'; }
    d.innerHTML = '<span class="ln">' + (idx + 1) + '</span>' + esc(l === '' ? ' ' : l);
    el.appendChild(d);
  });
}

function countLines(s){
  if(s === null){ return 0; }
  return s.split('\n').filter(function(x){ return x !== ''; }).length;
}

function saveGame(){
  var name = clean(gv('sv-name')) || '无名英雄';
  var level = clean(gv('sv-level')) || '1';
  var gold = clean(gv('sv-gold')) || '0';
  var hadOld = saveFile !== null;
  var oldLines = countLines(saveFile);
  saveFile = '名字:' + name + '\n等级:' + level + '\n金币:' + gold + '\n';

  var code = '# 💾 保存存档：with + "w" 模式写入\n' +
    'with open("game_save.txt", "w", encoding="utf-8") as f:\n' +
    '    f.write("名字:' + name + '\\n")\n' +
    '    f.write("等级:' + level + '\\n")\n' +
    '    f.write("金币:' + gold + '\\n")\n' +
    '# 出了 with 代码块，文件自动关闭，不用写 f.close()';
  document.getElementById('lab-code').innerHTML = hl(code);
  renderFile('file-save', saveFile, 0);

  var steps = [
    {d:0,   t:'🔓 with open("game_save.txt", "w") —— 打开文件'}
  ];
  if(hadOld){
    steps.push({d:600, t:'⚠ "w" 模式打开的瞬间：原来的 ' + oldLines + ' 行旧存档被清空了！', c:'warn'});
  } else {
    steps.push({d:600, t:'✨ 文件不存在？没关系，"w" 会自动创建', c:'ok'});
  }
  steps.push({d:1200, t:'✍ 写入：名字:' + name});
  steps.push({d:1600, t:'✍ 写入：等级:' + level});
  steps.push({d:2000, t:'✍ 写入：金币:' + gold});
  steps.push({d:2600, t:'✓ 离开 with 代码块，文件已自动关闭（这就是 with 的温柔）', c:'ok'});
  setStatus(steps);
}

function loadGame(){
  var code = '# 📖 读取存档：for line in f 逐行解析\n' +
    'hero = {}\n' +
    'with open("game_save.txt", "r", encoding="utf-8") as f:\n' +
    '    for line in f:\n' +
    '        line = line.strip()      # 去掉行尾的 \\n\n' +
    '        key, value = line.split(":")\n' +
    '        hero[key] = value\n\n' +
    'print(hero)';
  document.getElementById('lab-code').innerHTML = hl(code);

  if(saveFile === null){
    setStatus([
      {d:0,   t:'🔓 with open("game_save.txt", "r") —— 打开文件'},
      {d:700, t:'💥 FileNotFoundError: 还没存过档！先点「保存存档」', c:'warn'}
    ]);
    return;
  }
  renderFile('file-save', saveFile, 0);

  var lines = saveFile.split('\n').filter(function(x){ return x !== ''; });
  var hero = {};
  lines.forEach(function(l){
    var p = l.split(':');
    hero[p[0]] = p[1];
  });
  var outStr = '{' + lines.map(function(l){
    var p = l.split(':');
    return "'" + p[0] + "': '" + p[1] + "'";
  }).join(', ') + '}';

  setStatus([
    {d:0,    t:'🔓 with open("game_save.txt", "r") —— 打开文件'},
    {d:600,  t:'📖 for line in f —— 逐行读取（大文件也扛得住）'},
    {d:1300, t:'🔧 strip() 去掉 \\n，split(":") 拆成键和值'},
    {d:2000, t:'✓ 自动关闭，读取完成', c:'ok'},
    {d:2600, t:'🏅 存档还原成功：名字=' + hero['名字'] + ' 等级=' + hero['等级'] + ' 金币=' + hero['金币'], c:'ok'}
  ]);

  var card = document.getElementById('load-card');
  card.classList.remove('show'); void card.offsetWidth; card.classList.add('show');
  document.getElementById('ld-name').textContent = '⚔ ' + (hero['名字'] || '—');
  document.getElementById('ld-level').textContent = hero['等级'] || '—';
  document.getElementById('ld-gold').textContent = hero['金币'] || '—';
  document.getElementById('ld-lines').textContent = lines.length;
  var outBox = document.getElementById('load-out');
  outBox.style.display = 'block';
  outBox.textContent = outStr;
}

function appendLog(){
  battleNo++;
  var m = monsters[(battleNo - 1) % monsters.length];
  var gold = 50 * battleNo;
  var line = '第' + battleNo + '场：击败了' + m + '，金币+' + gold;
  var existed = logFile !== null;
  var oldCount = countLines(logFile);
  logFile = (logFile === null ? '' : logFile) + line + '\n';

  var code = '# ⚔ 追加战绩："a" 模式只往末尾写，不动老内容\n' +
    'with open("battle_log.txt", "a", encoding="utf-8") as f:\n' +
    '    f.write("' + line + '\\n")';
  document.getElementById('lab-code').innerHTML = hl(code);
  renderFile('file-log', logFile, oldCount);

  var steps = [{d:0, t:'🔓 with open("battle_log.txt", "a") —— 打开文件'}];
  if(existed){
    steps.push({d:600, t:'🛡 原有 ' + oldCount + ' 条战绩完好保留（这就是 "a" 的温柔）', c:'ok'});
  } else {
    steps.push({d:600, t:'✨ 文件不存在？"a" 模式会自动创建', c:'ok'});
  }
  steps.push({d:1200, t:'✍ 追加写入：' + line});
  steps.push({d:1800, t:'✓ 自动关闭，完成', c:'ok'});
  setStatus(steps);
}

function dangerLog(){
  if(logFile === null){
    setStatus([{d:0, t:'战绩日志还不存在，先点「⚔ 记录战绩」打几场再来', c:'warn'}]);
