  "野狼":       {hp:60,  atk:12, df:4,  rar:"★ 普通",      desc:"月圆之夜会召唤同伴"},
  "宝藏史莱姆": {hp:50,  atk:2,  df:50, rar:"★ 普通",      desc:"打死后掉一堆金币"},
  "骷髅兵":     {hp:80,  atk:15, df:8,  rar:"★★ 精英",     desc:"墓地常驻保安"},
  "石魔像":     {hp:150, atk:18, df:20, rar:"★★ 精英",     desc:"物理攻击对它基本是挠痒"},
  "寒冰巫师":   {hp:90,  atk:30, df:6,  rar:"★★★ 首领",    desc:"冻住你不商量"},
