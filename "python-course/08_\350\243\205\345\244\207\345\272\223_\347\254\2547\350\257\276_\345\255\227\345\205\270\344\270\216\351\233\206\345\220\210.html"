<script>
/* ============ 工具 ============ */
function esc(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ============ 板块1：按键取值卡片 ============ */
function pickCard(el){
  var k = el.getAttribute('data-k');
