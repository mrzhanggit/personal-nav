  "暗影龙":     {hp:400, atk:60, df:25, rar:"★★★★ 传说",  desc:"装备库终极考核官"}
};
var rarityColors = ['#4dd6ff', '#a78bfa', '#f5c542', '#f472b6'];
var dex = {};

function setLabCode(html){
  var el = document.getElementById('lab-code');
  el.style.display = 'block';
  el.innerHTML = html;
}
function updateProgress(){
  var total = Object.keys(monsterDB).length;
  var got = Object.keys(dex).length;
  var pct = Math.round(got / total * 100);
  document.getElementById('dex-fill').style.width = pct + '%';
  document.getElementById('dex-label').textContent =
    '图鉴收集进度：' + got + ' / ' + total + '（' + pct + '%）' +
    (got === total ? ' 🎉 图鉴大师达成！装备库主管向你致敬！' : '');
}
function showEnc(name, m, repeat){
  var card = document.getElementById('enc-card');
  document.getElementById('enc-name').textContent = (repeat ? '🔁 再次遭遇 · ' : '⚔ 遭遇 · ') + name;
  var rar = document.getElementById('enc-rarity');
  rar.textContent = m.rar + (repeat ? '（已收录）' : '');
  var stars = m.rar.split(' ')[0].length;
  rar.style.color = rarityColors[Math.min(stars, 4) - 1];
  document.getElementById('enc-hp').textContent = m.hp;
  document.getElementById('enc-atk').textContent = m.atk;
  document.getElementById('enc-def').textContent = m.df;
  document.getElementById('enc-desc').textContent = repeat ? '「图鉴里已有它的记录，去查询框输入名字看看吧。」' : '「' + m.desc + '」';
  card.classList.remove('show'); void card.offsetWidth; card.classList.add('show');
  document.getElementById('lab-error').style.display = 'none';
}
function explore(){
  var names = Object.keys(monsterDB);
  var name = names[Math.floor(Math.random() * names.length)];
  var m = monsterDB[name];
  if(dex[name]){
    showEnc(name, m, true);
    setLabCode('<span class="c"># 野外再次遇到 ' + esc(name) + ' —— 图鉴中已有记录</span>\n' +
      '<span class="k">print</span>(<span class="s">"' + esc(name) + '"</span> <span class="k">in</span> <span class="v">dex</span>)   <span class="c"># True，用 in 检查键是否已收录</span>');
  } else {
    dex[name] = m;
    updateProgress();
    showEnc(name, m, false);
    setLabCode('<span class="c"># 野外探索 → 遭遇 ' + esc(name) + '，收录图鉴！</span>\n' +
      '<span class="v">dex</span>[<span class="s">"' + esc(name) + '"</span>] = {<span class="s">"hp"</span>: <span class="n">' + m.hp + '</span>, <span class="s">"atk"</span>: <span class="n">' + m.atk + '</span>, <span class="s">"def"</span>: <span class="n">' + m.df + '</span>}\n' +
      '<span class="k">print</span>(<span class="k">len</span>(<span class="v">dex</span>), <span class="s">"/"</span>, <span class="n">' + Object.keys(monsterDB).length + '</span>)   <span class="c"># 图鉴收集进度</span>');
  }
}
function queryMonster(){
  var name = document.getElementById('query-name').value.trim();
  if(!name){ alert('先输入要查询的怪物名，比如：哥布林'); return; }
  if(dex[name]){
    var m = dex[name];
    showEnc(name, m, false);
    document.getElementById('enc-name').textContent = '📖 图鉴查询 · ' + name;
    setLabCode('<span class="c"># 查询图鉴：安全姿势</span>\n' +
      '<span class="v">monster</span> = <span class="v">dex</span>.get(<span class="s">"' + esc(name) + '"</span>)   <span class="c"># 查不到返回 None，不报错</span>\n' +
      '<span class="k">print</span>(<span class="v">monster</span>[<span class="s">"hp"</span>], <span class="v">monster</span>[<span class="s">"atk"</span>])   <span class="c"># ' + m.hp + ' ' + m.atk + '</span>');
  } else if(monsterDB[name]){
    showEnc(name, monsterDB[name], false);
    document.getElementById('enc-name').textContent = '❓ 未收录 · ' + name;
    var t = document.getElementById('lab-error');
    t.style.display = 'block';
    t.textContent = 'Traceback (most recent call last):\n  File "<stdin>", line 1, in <module>\nKeyError: \'' + name + '\'';
    setLabCode('<span class="c"># 图鉴里还没有 ' + esc(name) + '，直接取值会爆炸：</span>\n' +
      '<span class="k">print</span>(<span class="v">dex</span>[<span class="s">"' + esc(name) + '"</span>])        <span class="c"># 💥 KeyError —— 还没收录！</span>\n' +
      '<span class="k">print</span>(<span class="v">dex</span>.get(<span class="s">"' + esc(name) + '"</span>, <span class="s">"未收录"</span>))   <span class="c"># ✅ 安全返回默认值</span>');
  } else {
    alert('野外没有叫「' + name + '」的怪物。提示：史莱姆、哥布林、野狼、宝藏史莱姆、骷髅兵、石魔像、寒冰巫师、双头食人魔、暗影龙');
  }
}
function resetDex(){
  dex = {};
  updateProgress();
  document.getElementById('enc-card').classList.remove('show');
  document.getElementById('lab-error').style.display = 'none';
  setLabCode('<span class="v">dex</span>.clear()   <span class="c"># 清空图鉴，重新出发</span>');
}
