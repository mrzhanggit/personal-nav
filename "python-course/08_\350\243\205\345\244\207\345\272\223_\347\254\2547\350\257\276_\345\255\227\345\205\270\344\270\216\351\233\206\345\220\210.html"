    '<span class="k">print</span>(<span class="v">bag</span>[<span class="s">"' + k + '"</span>])   <span class="c"># 按「键」取「值」</span>';
  var o = document.getElementById('pick-out');
  o.style.display = 'block';
  o.textContent = v;
}

/* ============ 板块2：KeyError vs get ============ */
function tryDirect(){
  var t = document.getElementById('key-err');
  t.style.display = 'block';
  t.textContent = 'Traceback (most recent call last):\n  File "<stdin>", line 1, in <module>\nKeyError: \'火龙\'';
  document.getElementById('get-code').style.display = 'none';
  document.getElementById('get-out').style.display = 'none';
}
function tryGet(){
  document.getElementById('key-err').style.display = 'none';
  document.getElementById('get-code').style.display = 'block';
  document.getElementById('get-out').style.display = 'block';
}

/* ============ 板块3：字典增删改演示 ============ */
var bagDemo = {"金币": 300, "药水": 3, "地图": 1};
function pyDictRepr(o){
  var parts = [];
  for(var k in o){ parts.push('"' + k + '": ' + o[k]); }
  return '{' + parts.join(', ') + '}';
}
function renderChips(){
  var box = document.getElementById('bag-chips');
  box.innerHTML = '';
  for(var k in bagDemo){
    var c = document.createElement('div');
    c.className = 'chip';
    c.innerHTML = esc(k) + ' : <b>' + bagDemo[k] + '</b>';
    box.appendChild(c);
  }
}
function bagCode(line, comment){
  document.getElementById('bag-code').style.display = 'block';
  document.getElementById('bag-code').innerHTML =
    line + '\n<span class="k">print</span>(<span class="v">bag</span>)   <span class="c"># ' + comment + ' bag = ' + esc(pyDictRepr(bagDemo)) + '</span>';
}
function bagAdd(){
  if(!("卷轴" in bagDemo)) bagDemo["卷轴"] = 2;
  renderChips();
  bagCode('<span class="v">bag</span>[<span class="s">"卷轴"</span>] = <span class="n">2</span>   <span class="c"># 增：键不存在 → 新增</span>', '现在');
}
function bagMod(){
  if("药水" in bagDemo) bagDemo["药水"] = 5;
  renderChips();
  bagCode('<span class="v">bag</span>[<span class="s">"药水"</span>] = <span class="n">5</span>   <span class="c"># 改：键已存在 → 覆盖旧值</span>', '现在');
}
function bagDel(){
  delete bagDemo["地图"];
  renderChips();
  bagCode('<span class="k">del</span> <span class="v">bag</span>[<span class="s">"地图"</span>]   <span class="c"># 删：彻底移除这个键</span>', '现在');
}
renderChips();

/* ============ 板块5：集合运算 ============ */
var setA = ["剑", "盾", "药"], setB = ["盾", "药", "弓"];
function setPy(list){
  return '{' + list.map(function(x){ return "'" + x + "'"; }).join(', ') + '}';
}
function setOp(op){
  var sym, res, tip;
  if(op === 'and'){ sym = '&amp;'; res = setA.filter(function(x){ return setB.indexOf(x) >= 0; }); tip = '交集：两边都有'; }
  else if(op === 'or'){
    sym = '|'; res = setA.slice();
    setB.forEach(function(x){ if(res.indexOf(x) < 0) res.push(x); });
    tip = '并集：全部合起来再去重';
  }
  else{ sym = '-'; res = setA.filter(function(x){ return setB.indexOf(x) < 0; }); tip = '差集：A 有而 B 没有'; }
  var py = setPy(res);
  document.getElementById('set-code').style.display = 'block';
  document.getElementById('set-code').innerHTML =
    '<span class="v">a</span> = {<span class="s">"剑"</span>, <span class="s">"盾"</span>, <span class="s">"药"</span>}\n' +
    '<span class="v">b</span> = {<span class="s">"盾"</span>, <span class="s">"药"</span>, <span class="s">"弓"</span>}\n' +
    '<span class="k">print</span>(<span class="v">a</span> ' + sym + ' <span class="v">b</span>)   <span class="c"># ' + tip + '</span>';
  var o = document.getElementById('set-out');
  o.style.display = 'block';
  o.textContent = py + '   （集合无序，打印顺序可能不同）';
}

/* ============ 实验室：怪物图鉴收集系统 ============ */
var monsterDB = {
  "史莱姆":     {hp:30,  atk:5,  df:1,  rar:"★ 普通",      desc:"新手村第一经验包"},
