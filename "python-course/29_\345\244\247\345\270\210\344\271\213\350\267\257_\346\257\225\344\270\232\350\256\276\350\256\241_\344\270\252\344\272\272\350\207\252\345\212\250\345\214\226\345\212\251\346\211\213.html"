      <h3 style="color:var(--gold)">♛ 合体 · 整合框架完整骨架（main.py · 约 120 行）</h3>
      <p>四个里程碑拼成最终形态：<span class="hl">配置区 → 日志 → 通用护甲 → 四个模块 → 主调度器</span>。照着这个骨架填装你自己的功能，本周末你的助手就能上岗：</p>
      <div class="code"><span class="s">&quot;&quot;&quot;个人自动化助手 · 整合框架骨架
================================
每天 08:30 自动执行：整理文件 → 抓取天气 → 汇总数据 → 生成日报并通知
依赖安装：pip install schedule requests pandas
&quot;&quot;&quot;</span>
<span class="k">import</span> logging
<span class="k">import</span> shutil
<span class="k">import</span> time
<span class="k">from</span> datetime <span class="k">import</span> datetime
<span class="k">from</span> pathlib <span class="k">import</span> Path

<span class="k">import</span> pandas <span class="k">as</span> pd
<span class="k">import</span> requests
<span class="k">import</span> schedule

<span class="c"># ---------- 配置区：所有会变的参数集中一处 ----------</span>
CONFIG = {
    <span class="s">&quot;messy_folder&quot;</span>: Path.<span class="v">home</span>() / <span class="s">&quot;Downloads&quot;</span>,   <span class="c"># 待整理的文件夹</span>
    <span class="s">&quot;city&quot;</span>: <span class="s">&quot;beijing&quot;</span>,                           <span class="c"># 天气接口的城市代码</span>
    <span class="s">&quot;out_dir&quot;</span>: <span class="v">Path</span>(<span class="s">&quot;assistant_output&quot;</span>),         <span class="c"># 报告输出目录</span>
    <span class="s">&quot;retry&quot;</span>: <span class="n">2</span>,                                  <span class="c"># 网络失败重试次数</span>
}

<span class="c"># ---------- 日志：无人值守系统的黑匣子 ----------</span>
logging.<span class="v">basicConfig</span>(
    filename=<span class="s">&quot;assistant.log&quot;</span>,
    level=logging.INFO,
    format=<span class="s">&quot;%(asctime)s [%(levelname)s] %(message)s&quot;</span>,
)

<span class="c"># ---------- 通用护甲：崩了不连坐，还能重试 ----------</span>
<span class="k">def</span> <span class="v">safe_run</span>(job_name, job_func, *args, **kwargs):
    <span class="k">for</span> attempt <span class="k">in</span> <span class="v">range</span>(<span class="n">1</span>, CONFIG[<span class="s">&quot;retry&quot;</span>] + <span class="n">1</span>):
        <span class="k">try</span>:
            result = <span class="v">job_func</span>(*args, **kwargs)
            logging.<span class="v">info</span>(<span class="s">&quot;%s 成功：%s&quot;</span>, job_name, result)
            <span class="k">return</span> result
        <span class="k">except</span> Exception <span class="k">as</span> e:
            logging.<span class="v">warning</span>(<span class="s">&quot;%s 第 %s 次失败：%s&quot;</span>, job_name, attempt, e)
            time.<span class="v">sleep</span>(<span class="n">2</span>)                    <span class="c"># 缓两秒再试，别把对方服务器打急了</span>
    logging.<span class="v">error</span>(<span class="s">&quot;%s 连续失败，跳过本次任务&quot;</span>, job_name)
    <span class="k">return</span> <span class="k">None</span>

<span class="c"># ---------- 模块 A：文件整理（复用 BOSS3 桌面自动整理器） ----------</span>
EXT_MAP = {
    <span class="s">&quot;图片&quot;</span>: [<span class="s">&quot;.png&quot;</span>, <span class="s">&quot;.jpg&quot;</span>, <span class="s">&quot;.gif&quot;</span>],
    <span class="s">&quot;文档&quot;</span>: [<span class="s">&quot;.pdf&quot;</span>, <span class="s">&quot;.docx&quot;</span>, <span class="s">&quot;.txt&quot;</span>],
    <span class="s">&quot;表格&quot;</span>: [<span class="s">&quot;.xlsx&quot;</span>, <span class="s">&quot;.csv&quot;</span>],
}
ALL_EXTS = {ext <span class="k">for</span> exts <span class="k">in</span> EXT_MAP.<span class="v">values</span>() <span class="k">for</span> ext <span class="k">in</span> exts}

<span class="k">def</span> <span class="v">job_organize</span>(folder):
    moved = <span class="n">0</span>
    <span class="k">for</span> f <span class="k">in</span> <span class="v">Path</span>(folder).<span class="v">iterdir</span>():
        <span class="k">if</span> f.<span class="v">is_file</span>() <span class="k">and</span> f.suffix.<span class="v">lower</span>() <span class="k">in</span> ALL_EXTS:
            <span class="k">for</span> kind, exts <span class="k">in</span> EXT_MAP.<span class="v">items</span>():
                <span class="k">if</span> f.suffix.<span class="v">lower</span>() <span class="k">in</span> exts:
                    target = <span class="v">Path</span>(folder) / kind
                    target.<span class="v">mkdir</span>(exist_ok=<span class="k">True</span>)
                    shutil.<span class="v">move</span>(<span class="v">str</span>(f), <span class="v">str</span>(target / f.name))
                    moved += <span class="n">1</span>
                    <span class="k">break</span>
    <span class="k">return</span> moved

<span class="c"># ---------- 模块 B：信息抓取（requests + API） ----------</span>
<span class="k">def</span> <span class="v">job_fetch_weather</span>(city):
    resp = requests.<span class="v">get</span>(
        <span class="s">&quot;wttr.in/&quot;</span> + city,      <span class="c"># 演示骨架：协议头省略，实际使用需补全（第 13 课）</span>
        params={<span class="s">&quot;format&quot;</span>: <span class="s">&quot;j1&quot;</span>},
        timeout=<span class="n">10</span>,
    )
    resp.<span class="v">raise_for_status</span>()
    data = resp.<span class="v">json</span>()
    <span class="k">return</span> data[<span class="s">&quot;current_condition&quot;</span>][<span class="n">0</span>][<span class="s">&quot;temp_C&quot;</span>]

<span class="c"># ---------- 模块 C：数据汇总（pandas，复用第 23 课） ----------</span>
<span class="k">def</span> <span class="v">job_summarize</span>(rows):
    df = pd.<span class="v">DataFrame</span>(rows)
    CONFIG[<span class="s">&quot;out_dir&quot;</span>].<span class="v">mkdir</span>(exist_ok=<span class="k">True</span>)
    df.<span class="v">to_csv</span>(CONFIG[<span class="s">&quot;out_dir&quot;</span>] / <span class="s">&quot;run_log.csv&quot;</span>,
              index=<span class="k">False</span>, encoding=<span class="s">&quot;utf-8-sig&quot;</span>)
    <span class="k">return</span> <span class="v">len</span>(df)

<span class="c"># ---------- 模块 D：报告生成与通知 ----------</span>
<span class="k">def</span> <span class="v">job_report</span>(temp, moved, total):
    lines = [
        <span class="s">&quot;===== 个人助手日报 %s =====&quot;</span> % datetime.<span class="v">now</span>().<span class="v">strftime</span>(<span class="s">&quot;%Y-%m-%d&quot;</span>),
        <span class="s">&quot;今日温度：%s ℃&quot;</span> % temp,
        <span class="s">&quot;整理文件：%s 个&quot;</span> % moved,
        <span class="s">&quot;累计记录：%s 条&quot;</span> % total,
    ]
    report = <span class="s">&quot;\n&quot;</span>.<span class="v">join</span>(lines)
    (CONFIG[<span class="s">&quot;out_dir&quot;</span>] / <span class="s">&quot;daily_report.txt&quot;</span>).<span class="v">write_text</span>(report, encoding=<span class="s">&quot;utf-8&quot;</span>)
    <span class="v">print</span>(report)      <span class="c"># 终端通知；进阶可换成钉钉/邮件 webhook 推送</span>
    <span class="k">return</span> report

<span class="c"># ---------- 主调度器：把四个模块串成一条流水线 ----------</span>
<span class="k">def</span> <span class="v">morning_job</span>():
    log_path = CONFIG[<span class="s">&quot;out_dir&quot;</span>] / <span class="s">&quot;run_log.csv&quot;</span>
    <span class="k">if</span> log_path.<span class="v">exists</span>():
        rows = pd.<span class="v">read_csv</span>(log_path).<span class="v">to_dict</span>(<span class="s">&quot;records&quot;</span>)
    <span class="k">else</span>:
        rows = []
    temp = <span class="v">safe_run</span>(<span class="s">&quot;天气抓取&quot;</span>, job_fetch_weather, CONFIG[<span class="s">&quot;city&quot;</span>])
    moved = <span class="v">safe_run</span>(<span class="s">&quot;文件整理&quot;</span>, job_organize, CONFIG[<span class="s">&quot;messy_folder&quot;</span>]) <span class="k">or</span> <span class="n">0</span>
    rows.<span class="v">append</span>({<span class="s">&quot;日期&quot;</span>: datetime.<span class="v">now</span>().<span class="v">strftime</span>(<span class="s">&quot;%Y-%m-%d&quot;</span>),
                 <span class="s">&quot;温度&quot;</span>: temp, <span class="s">&quot;文件数&quot;</span>: moved})
    total = <span class="v">safe_run</span>(<span class="s">&quot;数据汇总&quot;</span>, job_summarize, rows) <span class="k">or</span> <span class="v">len</span>(rows)
    <span class="v">safe_run</span>(<span class="s">&quot;报告生成&quot;</span>, job_report, temp, moved, total)

<span class="k">def</span> <span class="v">main</span>():
    CONFIG[<span class="s">&quot;out_dir&quot;</span>].<span class="v">mkdir</span>(exist_ok=<span class="k">True</span>)
    schedule.<span class="v">every</span>().day.<span class="v">at</span>(<span class="s">&quot;08:30&quot;</span>).<span class="v">do</span>(morning_job)
    logging.<span class="v">info</span>(<span class="s">&quot;调度器启动，每天 08:30 自动执行&quot;</span>)
    <span class="k">while</span> <span class="k">True</span>:
        schedule.<span class="v">run_pending</span>()
        time.<span class="v">sleep</span>(<span class="n">1</span>)

<span class="k">if</span> __name__ == <span class="s">&quot;__main__&quot;</span>:
    <span class="v">main</span>()</div>
