<script>
/* ============ 验收清单 ============ */
var ckData = [
  '⏰ <b>定时运行</b>：每天 08:30 无人值守自动执行，全程不需要人按任何键',
  '📦 <b>模块A 文件整理</b>：指定文件夹整理后 0 个散乱目标文件（按扩展名归档，.zip 这类不认识的文件安然无恙）',
  '📡 <b>模块B 信息抓取</b>：外部数据获取失败时自动重试；重试失败记录日志并跳过，而不是崩溃',
  '💾 <b>数据持久化</b>：每次运行的结果追加进 run_log.csv，重启程序后历史一条不丢',
  '📊 <b>模块C 数据汇总</b>：pandas 能正确汇总历史记录（groupby 出执行次数与结果统计）',
  '📨 <b>模块D 报告通知</b>：每天生成一份可读的 daily_report.txt 日报，并有输出通知',
  '🛡 <b>异常防护</b>：任何一个模块抛异常，系统不退出、日志留痕、其余模块照常执行',
  '📜 <b>工程规范</b>：README 写清安装与使用；git 管理项目，.gitignore 排除 venv/ 与 .env'
];
var ckDone = [];
(function(){
  var box = document.getElementById('ck-list');
  ckData.forEach(function(t, i){
    var d = document.createElement('div');
    d.className = 'ck-item';
    d.innerHTML = '<div class="ckbox">✓</div><span class="ck-txt">' + t + '</span>';
    d.addEventListener('click', function(){
      d.classList.toggle('done');
      ckDone[i] = d.classList.contains('done');
      updateCk();
    });
    box.appendChild(d);
    ckDone[i] = false;
  });
  updateCk();
})();
function updateCk(){
  var n = 0, i;
  for(i = 0; i < ckDone.length; i++){ if(ckDone[i]) n++; }
  var el = document.getElementById('ck-count');
  if(n >= ckData.length){
    el.innerHTML = '<b class="ck-full">8 / 8 全部达成！</b> 毕业答辩在等你，去吧';
  } else {
    el.innerHTML = '已达成 <b>' + n + ' / ' + ckData.length + '</b> —— 全部勾完再参加毕业答辩';
  }
}

/* ============ 大师自评表 ============ */
var dims = [
  {name:'功能完成度', desc:'四个模块是否都真实干活，而非占位假数据？'},
  {name:'代码质量', desc:'命名见名知意、函数职责单一、关键处有注释？'},
  {name:'稳定性', desc:'断网、缺文件夹、API 抽风时，系统都不崩且有日志？'},
  {name:'数据闭环', desc:'记录真的落盘，第二天真的被读回来进了日报？'},
  {name:'工程规范', desc:'结构清晰、README 完整、git 历史干净、有测试？'}
];
var ratings = [0, 0, 0, 0, 0];
(function(){
  var box = document.getElementById('selfrate');
  dims.forEach(function(d, i){
    var row = document.createElement('div');
    row.className = 'rate-row';
    row.innerHTML = '<div class="rate-name"><b>' + d.name + '</b><small>' + d.desc + '</small></div>' +
                    '<div class="stars" id="stars-' + i + '"></div>';
    box.appendChild(row);
    var holder = row.querySelector('.stars');
    for(var s = 1; s <= 5; s++){
      (function(si){
        var b = document.createElement('button');
        b.className = 'star';
        b.textContent = '★';
        b.title = si + ' 星';
        b.addEventListener('click', function(){
          ratings[i] = si;
          drawStars();
        });
        holder.appendChild(b);
      })(s);
    }
  });
  drawStars();
})();
function drawStars(){
  var i, j;
  for(i = 0; i < dims.length; i++){
    var btns = document.getElementById('stars-' + i).querySelectorAll('.star');
    for(j = 0; j < btns.length; j++){
      if(j < ratings[i]){ btns[j].classList.add('on'); }
      else{ btns[j].classList.remove('on'); }
    }
  }
  var total = ratings[0] + ratings[1] + ratings[2] + ratings[3] + ratings[4];
  var el = document.getElementById('rate-result');
  var allRated = (ratings.indexOf(0) === -1);
  if(allRated){
    var msg;
    if(total >= 22){ msg = total + ' / 25 —— 大师中的大师，这个项目可以直接写进简历！'; }
    else if(total >= 17){ msg = total + ' / 25 —— 扎实的毕业作品，短板就是你下一个项目的进化方向'; }
    else{ msg = total + ' / 25 —— 项目已成型，按自评短板迭代一轮，再来重新打分'; }
    el.innerHTML = '大师自评：<b>' + msg + '</b>';
    el.classList.add('show');
  } else {
    el.classList.remove('show');
  }
}

/* ============ 全课程记忆卡片 ============ */
var cardData = [
  ['变量与类型转换', '新手村', '变量是贴了标签的盒子；先算右边再放左边；数字和文字相加要先 str() 转换'],
  ['函数：技能封装', '新手村', '把一段魔法封进函数：参数是入场券，return 是战利品，一个函数只干一件事'],
  ['try/except 防崩护盾', '装备库', 'except Exception as e 兜住报错攻击，程序再也不闪退——无人值守系统的生死线'],
  ['with open 持久化', '装备库', 'with open(路径, "w", encoding="utf-8") as f 自动关门，数据在关机后依然存在'],
  ['requests + API', '副本挑战', 'requests.get(地址, timeout=10).json() 三步拿情报；timeout 和 raise_for_status 是安全带'],
  ['pathlib + shutil', '副本挑战', 'Path 遍历文件夹、suffix 看扩展名、shutil.move 归档——批量文件操作三件套'],
  ['类与对象', '进阶秘境', 'class 描述种族：__init__ 发初始装备，self 是「我自己」，对象 = 属性 + 行为'],
  ['装饰器附魔', '进阶秘境', '@装饰器 给函数加计时/日志/缓存效果，不动原函数一根毫毛'],
  ['Git 三区模型', '大师之路', '工作区 →git add→ 暂存区 →git commit→ 仓库；checkout 哈希 读档回退'],
  ['pandas 汇总', '大师之路', 'DataFrame 存表格、groupby 分组聚合、to_csv 落盘——一行抵十行循环']
];
(function(){
  var grid = document.getElementById('cards');
  cardData.forEach(function(c){
    var d = document.createElement('div');
    d.className = 'mcard';
    d.innerHTML = '<div class="mcard-inner">' +
      '<div class="mface mfront"><small>' + c[1] + '</small>' + c[0] + '</div>' +
      '<div class="mface mback">' + c[2] + '</div></div>';
    d.addEventListener('click', function(){ d.classList.toggle('flip'); });
    grid.appendChild(d);
  });
})();

/* ============ 毕业答辩 Quiz ============ */
var quizData = [
  {q:'毕业系统的「模块B 信息抓取」要拿今天的真实天气，标准姿势是哪一套？',
   opts:['requests.get(地址, timeout=10) 发请求，再用 .json() 解析回执',
         'print() 把天气打印出来',
         'random.randint(1, 40) 猜一个温度',
         'input() 让用户每天手输温度'], ans:0,
   exp:'第 13 课「情报网」：requests 负责发请求，.json() 负责解析；timeout 防止服务器装死拖垮调度器——这是无人值守系统的安全带。'},
  {q:'为什么整个系统必须套上 try/except + 日志（logging）？',
   opts:['让代码看起来更专业',
         '因为无人值守：没有人在旁边点「确定」，模块崩了必须自己兜住并留下日志，才不拖垮其他模块',
         'Python 语法规定必须写',
         '防止别人看懂你的代码'], ans:1,
   exp:'第 10 课 + 毕业设计里程碑4：safe_run 护甲让任何模块崩了都返回 None 并记入 assistant.log，系统继续跑，三天后排查也有据可查。'},
  {q:'日报里的「各模块累计统计」为什么用 pandas 而不是手写循环？',
   opts:['手写循环在 Python 里已被禁用',
         'pandas 的图表颜色更多',
         '一行 groupby 聚合顶十行手写循环，还能直接 to_csv 落盘，且不易写错',
         'pandas 运行不需要内存'], ans:2,
   exp:'第 23 课「千里眼」：DataFrame + groupby + agg 三板斧，把「分组统计」从循环苦力活变成一行声明——这就是数据分析的王牌。'},
  {q:'「每天 08:30 自动运行」由哪段代码实现？',
   opts:['在代码末尾写 input("按回车运行")',
         'schedule.every().day.at("08:30").do(任务) 配上 while True 循环里的 run_pending()',
         '用 print("该干活了") 每天喊一次',
         '把闹钟设在 08:30，每天手动运行一次'], ans:1,
   exp:'里程碑2：schedule 负责登记任务时间，while True + run_pending() 是心跳——每秒检查一次「到点了吗」，到点自动开火。'},
  {q:'综合题：历史运行记录为什么要写进 run_log.csv，而不是 print 完就完？',
   opts:['print 的内容关掉窗口就消失；CSV 落盘后第二天能读回来继续追加，日报才有历史可汇总',
         'CSV 文件比 print 高级',
         'print 是付费功能',
         '不写文件会被 Python 警告'], ans:0,
   exp:'第 9 课「存档系统」的终极意义：数据持久化让程序拥有「记忆」。今天的记录是明天日报的原材料——这就是数据闭环。'}
];
(function(){
  var box = document.getElementById('quiz');
  var answered = 0, score = 0;
  quizData.forEach(function(q, idx){
    var div = document.createElement('div');
    div.className = 'quiz-q';
    var optsHtml = q.opts.map(function(o, i){
      return '<button class="qq-opt" data-i="' + i + '">' + String.fromCharCode(65 + i) + '. ' + o + '</button>';
    }).join('');
    div.innerHTML = '<div class="qq"><i>Q' + (idx + 1) + '</i>' + q.q + '</div>' +
      '<div class="qq-opts">' + optsHtml + '</div>' +
      '<div class="qq-exp">' + q.exp + '</div>';
    box.appendChild(div);
    div.querySelectorAll('.qq-opt').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.classList.contains('right') || btn.classList.contains('wrong')) return;
        var i = +btn.dataset.i;
        answered++;
        if(i === q.ans){ btn.classList.add('right'); score++; }
        else{
          btn.classList.add('wrong');
          div.querySelectorAll('.qq-opt')[q.ans].classList.add('right');
        }
        div.querySelector('.qq-exp').classList.add('show');
        if(answered === quizData.length) showResult(score);
      });
    });
  });
  function showResult(s){
    var pts = s * 20;
    var el = document.getElementById('quiz-result');
    var msg = pts >= 80
      ? '答辩通过！「Python 高阶玩家」称号已就绪——去下方领证书吧 🔓'
      : '答辩未通过：把错题对应的关卡回炉一遍（卡片上有提示），刷新后重新答辩';
    el.innerHTML = '<b>' + pts + ' 分</b>' + s + ' / ' + quizData.length + ' 正确<br>' + msg;
    el.classList.add('show');
    el.scrollIntoView({behavior:'smooth', block:'center'});
  }
})();

/* ============ 毕业证书 ============ */
function grantCert(){
  var name = document.getElementById('grad-name').value.trim();
  if(!name){ alert('先写下你的名字——证书要实名颁发！'); return; }
  document.getElementById('cert-name').textContent = name;
  var d = new Date();
  document.getElementById('cert-date').textContent =
    d.getFullYear() + ' 年 ' + (d.getMonth() + 1) + ' 月 ' + d.getDate() + ' 日 · 大师之路 · 毕业认证';
  var cert = document.getElementById('cert');
  cert.classList.remove('show'); void cert.offsetWidth; cert.classList.add('show');
}
</script>
